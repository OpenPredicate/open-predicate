{
  "name": "json-query-language",
  "version": "0.4.0",
  "description": "A JSON-encoded, SQL-flavoured predicate language described by a single JSON Schema: $ref it from OpenAPI, or inline it into an MCP tool's inputSchema.",
  "type": "module",
  "license": "MIT",
  "author": "Christos Gkoros",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christosgkoros/json-query-language.git"
  },
  "homepage": "https://github.com/christosgkoros/json-query-language#readme",
  "bugs": {
    "url": "https://github.com/christosgkoros/json-query-language/issues"
  },
  "keywords": [
    "json-schema",
    "openapi",
    "query-language",
    "filter",
    "search",
    "mcp",
    "model-context-protocol",
    "agents",
    "llm-tools",
    "http-query-method"
  ],
  "main": "query-language-schema.json",
  "bin": {
    "jql-generate": "tools/generate-filter-schema.mjs"
  },
  "exports": {
    ".": "./query-language-schema.json",
    "./query-language-schema.json": "./query-language-schema.json",
    "./generate": "./tools/generate-filter-schema.mjs"
  },
  "files": [
    "query-language-schema.json",
    "tools/",
    "SPEC.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "generate": "node tools/generate-filter-schema.mjs",
    "generate:example": "node tools/generate-filter-schema.mjs --config examples/pet.jql.config.json",
    "example:mcp": "node examples/mcp-server/server.mjs",
    "example:mcp:demo": "node examples/mcp-server/demo.mjs",
    "test:experiment": "node --test experiments/filter-to-sql/compile.test.mjs",
    "experiment": "node experiments/filter-to-sql/run.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
